<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:controls="clr-namespace:AirIQ.Controls"
      xmlns:resx="clr-namespace:AirIQ.Resources.Strings"
      x:Class="AirIQ.Views.ContentViews.RoundTripContentView"
      Padding="16">

    <Border BackgroundColor="White"
        StrokeThickness="0"
        Padding="15"
        StrokeShape="RoundRectangle 12">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="18">

            <controls:ExtendedEntry Title="{x:Static resx:AppResource.From}"
                                    PlaceholderText="{x:Static resx:AppResource.SearchCityOrAirport}"
                                    Text="{Binding DepartureText}"/>

            <controls:ExtendedDatePicker Title="{x:Static resx:AppResource.TravelDate}" Grid.Row="1"/>

            <controls:ExtendedDropdown Title="{x:Static resx:AppResource.PaxSize}" Grid.Row="2"/>

            <controls:ExtendedDropdown Title="{x:Static resx:AppResource.Airline}" Grid.Row="3"/>

            <!-- No round-trip search command/properties exist at the ViewModel level (see
                 DashboardPage2ViewModel.cs: "One-way only for now - round-trip entry points are
                 commented out rather than removed"), and this whole view is not currently hosted by
                 any reachable page (TopTabView, the only thing that references
                 OneWayTripContentView/RoundTripContentView, is itself not embedded in any page's
                 XAML). Rather than fabricate a round-trip search implementation, the button is
                 disabled until round-trip support and this content view are actually wired up -
                 see report for the product/engineering decision needed here. -->
            <Button Text="{x:Static resx:AppResource.SearchFlights}"
                BackgroundColor="#FFD93B"
                TextColor="Black"
                CornerRadius="12"
                FontAttributes="Bold"
                HeightRequest="48"
                Margin="0,10,0,0"
                IsEnabled="False"
                Grid.Row="4"/>


        </Grid>

    </Border>

</Grid>
