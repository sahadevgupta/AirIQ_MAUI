<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirIQ.Views.ContentViews.ContactInformationView"
             xmlns:controls="clr-namespace:AirIQ.Controls"
             xmlns:resx="clr-namespace:AirIQ.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

        <Grid RowDefinitions="Auto,*"
              RowSpacing="10">

                <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static resx:AppResource.ContactInformationHeading}"
                               Style="{StaticResource Label18Medium}"
                               TextColor="{StaticResource PrimaryColor}"
                               LineHeight="1.2"
                               TextTransform="Uppercase"
                               CharacterSpacing="1.2"
                               Margin="0,8,0,0"/>

                        <controls:ExtendedDropdown Title="{x:Static resx:AppResource.Country}"
                                                   SuffixText="*"
                                                   PlaceholderText="{x:Static resx:AppResource.SelectCountry}"
                                                   ItemsSource="{Binding Countries}"
                                                   SelectedItem="{Binding SelectedCountry}"
                                                   IsError="{Binding IsCountryErrorVisible}"
                                                   ErrorText="{x:Static resx:AppResource.CountryIsRequired}"
                                                   DisplayMemberPath="Name"/>
                        <controls:ExtendedDropdown Title="{x:Static resx:AppResource.State}"
                                                   SuffixText="*"
                                                   PlaceholderText="{x:Static resx:AppResource.SelectState}"
                                                   ItemsSource="{Binding States}"
                                                   SelectedItem="{Binding SelectedState}"
                                                   IsError="{Binding IsStateErrorVisible}"
                                                   ErrorText="{x:Static resx:AppResource.StateIsRequired}"
                                                   DisplayMemberPath="Name"
                                                   IsEnabled="{Binding SelectedCountry, Converter={toolkit:IsNotNullConverter}}"/>
                        <controls:ExtendedDropdown Title="{x:Static resx:AppResource.District}"
                                                   SuffixText="*"
                                                   PlaceholderText="{x:Static resx:AppResource.SelectDistrict}"
                                                   ItemsSource="{Binding Districts}"
                                                   SelectedItem="{Binding SelectedDistrict}"
                                                   IsError="{Binding IsDistrictErrorVisible}"
                                                   ErrorText="{x:Static resx:AppResource.DistrictIsRequired}"
                                                   DisplayMemberPath="Name"
                                                   IsEnabled="{Binding SelectedState, Converter={toolkit:IsNotNullConverter}}"/>
                        <controls:ExtendedDropdown Title="{x:Static resx:AppResource.City}"
                                                   SuffixText="*"
                                                   PlaceholderText="{x:Static resx:AppResource.SelectCity}"
                                                   ItemsSource="{Binding Cities}"
                                                   SelectedItem="{Binding SelectedCity}"
                                                   IsError="{Binding IsCityErrorVisible}"
                                                   ErrorText="{x:Static resx:AppResource.CityIsRequired}"
                                                   DisplayMemberPath="CityName"
                                                   IsEnabled="{Binding SelectedDistrict, Converter={toolkit:IsNotNullConverter}}"/>
                        <controls:ExtendedEntry Title="{x:Static resx:AppResource.PinCode}"
                                                SuffixText="*"
                                                PlaceholderText="{x:Static resx:AppResource.EnterPincode}"
                                                Text="{Binding Signup.PinCode}"/>
                        <controls:ExtendedEntry Title="{x:Static resx:AppResource.Address}"
                                                SuffixText="*"
                                                PlaceholderText="{x:Static resx:AppResource.EnterAddress}"
                                                Text="{Binding Signup.Add1}"/>
                        <controls:ExtendedEntry Title="{x:Static resx:AppResource.SpecifyYourLocality}"
                                                SuffixText="*"
                                                PlaceholderText="{x:Static resx:AppResource.EnterLocality}"
                                                Text="{Binding Signup.Add2}"/>

                        <controls:ExtendedDropdown Title="{x:Static resx:AppResource.NearestAirport}"
                                                   SuffixText="*"
                                                   PlaceholderText="{x:Static resx:AppResource.SelectNearestAirport}"
                                                   ItemsSource="{Binding NearestAirport}"
                                                   SelectedItem="{Binding SelectedAirport}"
                                                   IsError="{Binding IsNearestAirportErrorVisible}"
                                                   ErrorText="{x:Static resx:AppResource.NearestAirportIsRequired}"
                                                   DisplayMemberPath="Name"
                                                   IsEnabled="{Binding SelectedCity, Converter={toolkit:IsNotNullConverter}}"/>
                </VerticalStackLayout>

                <Button Text="{x:Static resx:AppResource.Back}"
                        Grid.Row="1"
                        Margin="0,0,0,20"
                        TextColor="{StaticResource PrimaryColor}"
                        BackgroundColor="White"
                        Command="{Binding BackStepCommand}"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Style="{StaticResource SmallBorderButtonStyle}"/>


                <Button Text="{x:Static resx:AppResource.Next}"
                        Grid.Row="1"
                        Margin="0,0,0,20"
                        TextColor="White"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Command="{Binding NextStepCommand}"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Style="{StaticResource SmallBorderButtonStyle}"/>
        </Grid>
</ContentView>
