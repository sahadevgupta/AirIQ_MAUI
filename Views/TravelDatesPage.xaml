            <!-- ==================== WEEKDAY HEADER (fixed, doesn't scroll) ==================== -->
            <Grid Grid.Row="2"
                  Padding="20,8,20,8"
                  ColumnDefinitions="*,*,*,*,*,*,*">
                <Label Grid.Column="0"
                       Text="{x:Static resx:AppResource.DayMon}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="1"
                       Text="{x:Static resx:AppResource.DayTue}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="2"
                       Text="{x:Static resx:AppResource.DayWed}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="3"
                       Text="{x:Static resx:AppResource.DayThu}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="4"
                       Text="{x:Static resx:AppResource.DayFri}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="5"
                       Text="{x:Static resx:AppResource.DaySat}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Column="6"
                       Text="{x:Static resx:AppResource.DaySun}"
                       Style="{StaticResource Label12Medium}"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"/>
            </Grid>

            <!-- ==================== CALENDAR (scrolls behind the fixed Done button) ==================== -->
            <CollectionView Grid.Row="3"
                            IsVisible="True"
                            ItemsSource="{Binding Months}"
                            ItemSizingStrategy="MeasureFirstItem"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreMonthsCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CalendarMonth">
                        <controls:CalendarMonthView Month="{Binding .}"
                                                    DayTappedCommand="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectDayCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- <ScrollView Grid.Row="3">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Months}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CalendarMonth">
                            <controls:CalendarMonthView Month="{Binding .}"
                                                        DayTappedCommand="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectDayCommand}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView> -->

            <!-- ==================== DONE (fixed) ==================== -->
            <Button Grid.Row="4"
                    Text="{x:Static resx:AppResource.Done}"
                    Style="{StaticResource ButtonCorneredStyle}"
                    Command="{Binding DoneCommand}"
                    Margin="20,8,20,16"
                    HeightRequest="56"
                    CornerRadius="16"
                    TextTransform="None"/>

        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
