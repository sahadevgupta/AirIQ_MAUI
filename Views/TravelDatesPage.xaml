<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="AirIQ.Views.TravelDatesPage"
                xmlns:controls="clr-namespace:AirIQ.Controls"
                xmlns:helpers="clr-namespace:AirIQ.Extensions"
                xmlns:models="clr-namespace:AirIQ.Models"
                xmlns:resx="clr-namespace:AirIQ.Resources.Strings"
                xmlns:views="clr-namespace:AirIQ.Views"
                xmlns:vm="clr-namespace:AirIQ.ViewModels"
                x:Name="thisPage"
                x:DataType="vm:TravelDatesPageViewModel"
                IsNavBarVisible="False">

    <views:BasePage.Resources>
        <ResourceDictionary>
            <Style x:Key="StageTabStyle"
                   TargetType="Border">
                <Setter Property="Padding"
                        Value="16,10"/>
                <Setter Property="StrokeThickness"
                        Value="0"/>
                <Setter Property="StrokeShape"
                        Value="RoundRectangle 12"/>
                <Setter Property="BackgroundColor"
                        Value="Transparent"/>
            </Style>

            <Style x:Key="StageEyebrowStyle"
                   TargetType="Label">
                <Setter Property="FontFamily"
                        Value="RobotoSemiBold"/>
                <Setter Property="FontSize"
                        Value="11"/>
                <Setter Property="CharacterSpacing"
                        Value="0.4"/>
                <Setter Property="TextColor"
                        Value="{StaticResource Gray500}"/>
                <Setter Property="TextTransform"
                        Value="Uppercase"/>
            </Style>

            <Style x:Key="StageValueStyle"
                   TargetType="Label">
                <Setter Property="FontFamily"
                        Value="RobotoBold"/>
                <Setter Property="FontSize"
                        Value="16"/>
                <Setter Property="TextColor"
                        Value="{StaticResource Onyx}"/>
                <Setter Property="LineBreakMode"
                        Value="TailTruncation"/>
            </Style>
        </ResourceDictionary>
    </views:BasePage.Resources>

    <views:BasePage.PageContent>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              BackgroundColor="White">

            <!-- ==================== HEADER ==================== -->
            <Grid Grid.Row="0"
                  Padding="24,20,20,12"
                  ColumnDefinitions="*,Auto">

                <Label Grid.Column="0"
                       Text="{x:Static resx:AppResource.WhensYourTrip}"
                       Style="{StaticResource Label24Bold}"
                       TextColor="{StaticResource Onyx}"
                       VerticalOptions="Center"/>

                <Border Grid.Column="1"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource BackgroundColor}"
                        VerticalOptions="Center">
                    <Label Text="{x:Static helpers:FontAwesomeIcons.Times}"
                           FontFamily="MyFont"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- ==================== DEPARTURE / RETURN ==================== -->
            <!-- <Grid Grid.Row="1"
                  Padding="20,0,20,12"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                <Border Grid.Column="0"
