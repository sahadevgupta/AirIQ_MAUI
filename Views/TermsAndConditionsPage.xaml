<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="AirIQ.Views.TermsAndConditionsPage"
                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:AirIQ.Controls"
                xmlns:views="clr-namespace:AirIQ.Views"
                xmlns:resx="clr-namespace:AirIQ.Resources.Strings"
                IsWalletVisible="False"
                PageTitle="{x:Static resx:AppResource.TermsAndConditions}">

    <views:BasePage.PageContent>

        <ScrollView>
            <VerticalStackLayout Padding="16"
                                 Spacing="16">
                <!-- Main Heading -->
                <Label
                    Text="{x:Static resx:AppResource.TermsHeading1}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#111111"/>

                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara1}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara2}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara3}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara4}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara5}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara5}"/>

                <Label
                    Text="{x:Static resx:AppResource.TermsHeading2}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#111111"
                    Margin="0,10,0,0"/>

                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara6}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara7}"/>
                <controls:BulletLabel Text="{x:Static resx:AppResource.TermsPara8}"/>


            </VerticalStackLayout>
        </ScrollView>
    </views:BasePage.PageContent>
</views:BasePage>