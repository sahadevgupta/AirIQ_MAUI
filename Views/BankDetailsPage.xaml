<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="AirIQ_MAUI.Views.BankDetailsPage"
                xmlns:views="clr-namespace:AirIQ.Views"
                xmlns:vm="clr-namespace:AirIQ.ViewModels"
                xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
                x:DataType="vm:BankDetailsPageViewModel"
                PageTitle="Bank Details">

    <views:BasePage.PageContent>
        <ScrollView>
            <Grid Padding="16"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="10">
                <Border StrokeShape="RoundRectangle 4">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,Auto">
                        <Image Source="account_assured"
                               Margin="16,12"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Padding="0,16"
                                             Spacing="6">

                            <Button Text="ICICI Bank Limited"
                                    Style="{StaticResource BorderlessButton}"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Start"
                                    ImageSource="icici_logo"
                                    ContentLayout="Left,10"
                                    Padding="0"
                                    MinimumHeightRequest="0"
                                    BackgroundColor="Transparent"/>
                            <Label Text="IMPS / NEFT / RTGS"
                                   Style="{StaticResource Label14Regular}"/>
                        </VerticalStackLayout>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"/>

                        <Image Source="account_circle"
                               Margin="16,12"
                               Grid.Row="2"/>
                        <Label Grid.Column="1"
                               Grid.Row="2"
                               Padding="0,12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Name"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;AIR IQ Savings"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"/>

                        <Image Source="credit_card_circle"
                               Grid.Row="4"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="4">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Number"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;AQVI61065"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="5"
                                 Grid.ColumnSpan="2"/>

                        <!-- <Image Source="credit_card_circle"
                               Grid.Row="6"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="6">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Name"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;AIR IQ Savings"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="7"
                                 Grid.ColumnSpan="2"/> -->

                        <Image Source="wallet"
                               Grid.Row="8"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="8">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Type"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;Current Account"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="9"
                                 Grid.ColumnSpan="2"/>

                        <Image Source="account_bank"
                               Grid.Row="10"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="10">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="IFSC Code"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;ICIC00000104"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <VerticalStackLayout Grid.Row="11"
                                             Grid.ColumnSpan="2">


                            <Border BackgroundColor="#E5F3FE"
                                    Margin="16,12"
                                    StrokeThickness="0"
                                    Padding="10,8">
                                <Label Text="Note: If using ICICI Bank, Please use “Other Bank” option to add AIR IQ as beneficiary"
                                       Style="{StaticResource Label14MediumGray90Style}"
                                       TextColor="{StaticResource Gray70}"/>
                            </Border>

                            <BoxView Color="#E8E8E8"
                                     HeightRequest="1"/>
                            <Label Padding="16,12">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Scan QR code"
                                              Style="{StaticResource Span16BoldPrimaryStyle}"
                                              TextColor="Black"/>
                                        <Span Text="&#10;"/>
                                        <Span Text="scan the Qr code to pay"
                                              Style="{StaticResource Span12RegularGray50Style}"
                                              FontSize="14"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border Padding="0"
                                    HorizontalOptions="Center">
                                <Grid RowDefinitions="150,Auto">
                                    <zxing:BarcodeGeneratorView
                                        HeightRequest="150"
                                        WidthRequest="150"
                                        ForegroundColor="black"
                                        Value="{Binding QrValue}"
                                        Format="QrCode"
                                        Margin="3"/>

                                    <Label Text="ID: airiq@icici"
                                           VerticalOptions="Center"
                                           Style="{StaticResource Label14Bold}"
                                           Margin="10,0,0,5"
                                           Grid.Row="1"/>

                                    <Button Text="Copy"
                                            Grid.Row="1"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            Style="{StaticResource BorderlessButton}"
                                            MinimumHeightRequest="0"
                                            ImageSource="content_copy"
                                            ContentLayout="Right,2"
                                            Padding="0"
                                            Margin="0,0,5,5"/>
                                </Grid>

                            </Border>


                            <BoxView Color="#E8E8E8"
                                     Margin="0,12,0,0"
                                     HeightRequest="1"/>
                            <Label Padding="16,12">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="UPI Apps"
                                              Style="{StaticResource Span16BoldPrimaryStyle}"
                                              TextColor="Black"/>
                                        <Span Text="&#10;"/>
                                        <Span Text="Pay using UPI app"
                                              Style="{StaticResource Span12RegularGray50Style}"
                                              FontSize="14"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Grid Padding="16,0,16,16"
                                  ColumnDefinitions="*,*,*,*"
                                  ColumnSpacing="10">
                                <Border Stroke="#E9EDF5"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="10,14"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUpiAppCommand}"
                                                              CommandParameter="GooglePay"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Image Source="upi_googlepay"
                                               HeightRequest="42"
                                               WidthRequest="82"
                                               HorizontalOptions="Center"
                                               Aspect="AspectFit"/>
                                        <Label Text="Google Pay"
                                               Style="{StaticResource Label14Regular}"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#4F5B76"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        Stroke="#E9EDF5"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="10,14"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUpiAppCommand}"
                                                              CommandParameter="PhonePe"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Image Source="upi_phonepe"
                                               HeightRequest="42"
                                               WidthRequest="42"
                                               HorizontalOptions="Center"
                                               Aspect="AspectFit"/>
                                        <Label Text="PhonePe"
                                               Style="{StaticResource Label14Regular}"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#4F5B76"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="2"
                                        Stroke="#E9EDF5"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="10,14"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUpiAppCommand}"
                                                              CommandParameter="Paytm"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Image Source="upi_paytm"
                                               HeightRequest="42"
                                               WidthRequest="74"
                                               HorizontalOptions="Center"
                                               Aspect="AspectFit"/>
                                        <Label Text="Paytm"
                                               Style="{StaticResource Label14Regular}"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#4F5B76"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="3"
                                        Stroke="#E9EDF5"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="10,14"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUpiAppCommand}"
                                                              CommandParameter="BHIM"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Image Source="upi_bhim"
                                               HeightRequest="42"
                                               WidthRequest="58"
                                               HorizontalOptions="Center"
                                               Aspect="AspectFit"/>
                                        <Label Text="BHIM"
                                               Style="{StaticResource Label14Regular}"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#4F5B76"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        StrokeShape="RoundRectangle 4">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto,Auto">
                        <Image Source="account_assured"
                               Margin="16,12"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Padding="0,16"
                                             Spacing="6">

                            <Button Text="ICICI Bank Limited"
                                    Style="{StaticResource BorderlessButton}"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Start"
                                    ImageSource="icici_logo"
                                    ContentLayout="Left,10"
                                    Padding="0"
                                    MinimumHeightRequest="0"
                                    BackgroundColor="Transparent"/>
                            <Label Text="IMPS / NEFT / RTGS / Cash Deposit"
                                   Style="{StaticResource Label14Regular}"/>
                        </VerticalStackLayout>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"/>
                        <Image Source="account_circle"
                               Margin="16,12"
                               Grid.Row="2"/>
                        <Label Grid.Column="1"
                               Grid.Row="2"
                               Padding="0,12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Name"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;AIR IQ 365 Limited"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"/>

                        <Image Source="credit_card_circle"
                               Grid.Row="4"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="4">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Number"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;777705666135"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="5"
                                 Grid.ColumnSpan="2"/>

                        <Image Source="credit_card_circle"
                               Grid.Row="6"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="6">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Account Type"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;Current Account"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView Color="#E8E8E8"
                                 HeightRequest="1"
                                 Grid.Row="7"
                                 Grid.ColumnSpan="2"/>

                        <Image Source="account_bank"
                               Grid.Row="8"
                               Margin="16,12"/>
                        <Label Grid.Column="1"
                               Padding="0,12"
                               Grid.Row="8">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="IFSC Code"
                                          Style="{StaticResource Span16RegularGray50Style}"/>
                                    <Span Text="&#10;ICIC00000208"
                                          Style="{StaticResource Span16MediumBlacStyle}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Border BackgroundColor="#E5F3FE"
                                Grid.Row="9"
                                Grid.ColumnSpan="2"
                                Margin="16,12"
                                StrokeThickness="0"
                                Padding="10,8">
                            <Label Text="Note: If using ICICI Bank, Please use “Other Bank” option to add AIR IQ as beneficiary"
                                   Style="{StaticResource Label14MediumGray90Style}"
                                   TextColor="{StaticResource Gray70}"/>
                        </Border>

                    </Grid>

                </Border>

                <Border Grid.Row="2"
                        StrokeShape="RoundRectangle 4"
                        Padding="30,25">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         Spacing="10">
                        <Image Source="info_fill"
                               HeightRequest="30"/>
                        <Label HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"
                               Style="{StaticResource Label14Regular}"
                               TextColor="{StaticResource Gray90}">
                            <Label.Text>
                                We don't accept cash deposit over Rs. 1,90,000 in one day. If you deposit more than this, the extra amount will be lost and won't be added to your account.
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                </Border>

            </Grid>
        </ScrollView>
    </views:BasePage.PageContent>

</views:BasePage>