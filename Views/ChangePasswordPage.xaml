<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="AirIQ.Views.ChangePasswordPage"
                xmlns:controls="clr-namespace:AirIQ.Controls"
                xmlns:views="clr-namespace:AirIQ.Views"
                xmlns:vm="clr-namespace:AirIQ.ViewModels.Common"
                xmlns:resx="clr-namespace:AirIQ.Resources.Strings"
                BackgroundColor="White"
                x:DataType="vm:ChangePasswordPageViewModel">

       <Grid>

              <VerticalStackLayout VerticalOptions="Center"
                                   Padding="20,0">
                     <Image Source="lock_with_key"/>
                     <Label Text="{x:Static resx:AppResource.ChangePassword}"
                            Style="{StaticResource Label24Medium}"
                            HorizontalOptions="Center"
                            Margin="0,16,0,0"/>

                     <Label Text="{x:Static resx:AppResource.EnterPasswordDetails}"
                            Style="{StaticResource Label16Regular}"
                            Margin="0,6,0,0"
                            LineHeight="16.9"
                            HorizontalTextAlignment="Center"/>

                     <controls:ExtendedEntry Title="{x:Static resx:AppResource.OldPassword}"
                                             Margin="0,60,0,0"
                                             LeadingIconType="Image"
                                             LeadingIcon="person"
                                             PlaceholderText="{x:Static resx:AppResource.EnterEmailIdOrPhone}"
                                             IsVisible="False"/>

                     <controls:ExtendedEntry Title="{x:Static resx:AppResource.NewPassword}"
                                             Margin="0,20,0,0"
                                             LeadingIconType="Image"
                                             LeadingIcon="person"
                                             PlaceholderText="{x:Static resx:AppResource.EnterEmailIdOrPhone}"
                                             IsPassword="True"
                                             Text="{Binding Password}"/>

                     <controls:ExtendedEntry Title="{x:Static resx:AppResource.ConfirmPassword}"
                                             Margin="0,20,0,0"
                                             LeadingIconType="Image"
                                             LeadingIcon="person"
                                             PlaceholderText="{x:Static resx:AppResource.EnterEmailIdOrPhone}"
                                             IsPassword="True"
                                             Text="{Binding ConfirmPassword}"/>

                     <Button Style="{StaticResource ButtonCorneredStyle}"
                             Command="{Binding VerifyPasswordCommand}"
                             Margin="0,20,0,0"
                             Text="{x:Static resx:AppResource.ChangePassword}"/>

              </VerticalStackLayout>


              <VerticalStackLayout IsVisible="{Binding IsPasswordReseted}"
                                   BackgroundColor="{StaticResource PopupBackground}">
                     <Image Source="reset_success.png"
                            Margin="0,60,0,0"
                            Aspect="Center"
                            VerticalOptions="Center"/>

              </VerticalStackLayout>

       </Grid>
</views:BasePage>