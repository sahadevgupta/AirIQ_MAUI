<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="AirIQ.Views.DepartureDatePage"
                xmlns:controls="clr-namespace:AirIQ.Controls"
                xmlns:resx="clr-namespace:AirIQ.Resources.Strings"
                xmlns:views="clr-namespace:AirIQ.Views"
                xmlns:vm="clr-namespace:AirIQ.ViewModels"
                x:DataType="vm:DepartureDatePageViewModel"
                NavigationMode="Back"
                PageTitle="{x:Static resx:AppResource.SelectDepartureDate}">

    <views:BasePage.PageContent>
        <ScrollView>
            <controls:FareCalendarView x:Name="calendar"
                                        Padding="16"
                                        AllowedDates="{Binding AllowedDates}"
                                        SelectedDate="{Binding SelectedDate}"/>
        </ScrollView>
    </views:BasePage.PageContent>
</views:BasePage>
