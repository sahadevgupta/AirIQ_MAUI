<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirIQ.Controls.NavigationBarControl"
             x:Name="navigationBarControl"
             xmlns:ext="clr-namespace:AirIQ.Extensions"
             xmlns:drawables="clr-namespace:AirIQ.Resources.Drawables"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:resx="clr-namespace:AirIQ.Resources.Strings">


    <Grid ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="Auto"
          Padding="10"
          ColumnSpacing="16"
          BackgroundColor="{StaticResource PrimaryColor}">

        <Grid.Shadow>
            <Shadow Brush="Black"
                    Radius="10"
                    Offset="15,15"/>
        </Grid.Shadow>

        <ImageButton
            Margin="10,0,0,0"
            Aspect="AspectFit"
            BackgroundColor="transparent"
            Command="{Binding NavigateCommand, Source={x:Reference navigationBarControl}}"
            CommandParameter="{Binding NavigationMode, Source={x:Reference navigationBarControl}}"
            HorizontalOptions="Start"
            IsVisible="{Binding IsBackVisible, Source={x:Reference navigationBarControl}}"
            Source="back"
            VerticalOptions="Center"
            x:Name="navigationImage">

            <ImageButton.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{Binding BackButtonTintColor, Source={x:Reference navigationBarControl}}"/>
            </ImageButton.Behaviors>

        </ImageButton>

        <Label
            Grid.Column="1"
            FontSize="18"
            HorizontalOptions="Start"
            Style="{StaticResource Label12Medium}"
            TextColor="White"
            Text="{Binding Title, Source={x:Reference navigationBarControl}}"
            VerticalTextAlignment="Center">
            <!-- <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsWalletVisible, Source={x:Reference navigationBarControl}}"
                             Value="False">
                    <Setter Property="HorizontalTextAlignment"
                            Value="Center"/>
                </DataTrigger>
            </Label.Triggers> -->
        </Label>

        <HorizontalStackLayout Grid.Column="2"
                               HorizontalOptions="End"
                               VerticalOptions="Center">

            <Border Padding="10,4"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeThickness="1"
                    IsVisible="{Binding IsWalletVisible, Source={x:Reference navigationBarControl}}"
                    Stroke="White">

                <HorizontalStackLayout Spacing="0">

                    <Label Text="₹"
                           Style="{StaticResource Label16Regular}"
                           TextColor="White"
                           VerticalTextAlignment="Center"/>
                    <Label x:Name="amountSpan"
                           Style="{StaticResource Label14Medium}"
                           TextColor="White"
                           VerticalTextAlignment="Center"
                           Margin="4,0,8,0"/>
                    <Image Source="wallet_outline"
                           HeightRequest="20"/>
                </HorizontalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnWalletTapped"/>
                </Border.GestureRecognizers>

                <!-- <Button ImageSource="wallet_outline"
                    BorderWidth="1"
                    BorderColor="White"
                    Padding="4,2"
                    BackgroundColor="Transparent"
                    Style="{StaticResource SmallBorderButtonStyle}"
                    x:Name="amountSpan"/> -->

                <!-- <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            
                            <Span Text="&#x20B9; "
                                  Style="{StaticResource Span16BoldPrimaryStyle}"
                                  TextColor="{StaticResource PrimaryColor}"
                                  FontSize="{ext:ScaleFontSize Size=12}"/>
                            <Span x:Name="amountSpan"
                                  Style="{StaticResource Span16BoldPrimaryStyle}"
                                  TextColor="{StaticResource PrimaryColor}"
                                  FontSize="{ext:ScaleFontSize Size=12}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label> -->
            </Border>

            <ImageButton
                Aspect="AspectFit"
                IsVisible="{Binding EndIconSource, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}, Source={x:Reference navigationBarControl}}"
                Source="{Binding EndIconSource, Source={x:Reference navigationBarControl}}"
                Command="{Binding MenuCommand, Source={x:Reference navigationBarControl}}"/>

        </HorizontalStackLayout>



    </Grid>

</ContentView>
