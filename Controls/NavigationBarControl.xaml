<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirIQ.Controls.NavigationBarControl"
             x:Name="navigationBarControl"
             xmlns:drawables="clr-namespace:AirIQ.Resources.Drawables"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">


    <Grid ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="Auto"
          Padding="10"
          ColumnSpacing="16"
          BackgroundColor="{StaticResource PrimaryColor}">

        <Grid.Shadow>
            <Shadow Brush="Black"
                    Radius="10"
                    Offset="15,15"/>
        </Grid.Shadow>

        <ImageButton
            Margin="10,0,0,0"
            Aspect="AspectFit"
            BackgroundColor="transparent"
            Command="{Binding NavigateCommand, Source={x:Reference navigationBarControl}}"
            CommandParameter="{Binding NavigationMode, Source={x:Reference navigationBarControl}}"
            HorizontalOptions="Start"
            IsVisible="{Binding IsBackVisible, Source={x:Reference navigationBarControl}}"
            Source="back_button"
            VerticalOptions="Center"
            x:Name="navigationImage">

            <ImageButton.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{Binding BackButtonTintColor, Source={x:Reference navigationBarControl}}"/>
            </ImageButton.Behaviors>

        </ImageButton>

        <Label
            Grid.Column="1"
            FontSize="18"
            HorizontalOptions="Start"
            Style="{StaticResource Label12Medium}"
            TextColor="White"
            Text="{Binding Title, Source={x:Reference navigationBarControl}}"
            VerticalTextAlignment="Center"/>

        <HorizontalStackLayout Grid.Column="2"
                               HorizontalOptions="End"
                               VerticalOptions="Center">

            <Border Padding="8,6"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="#E5F3FE"
                    StrokeThickness="0"
                    IsVisible="{Binding EndIconSource, Converter={toolkit:IsStringNullOrWhiteSpaceConverter}, Source={x:Reference navigationBarControl}}">
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Balance: "
                                  Style="{StaticResource Span16BoldPrimaryStyle}"
                                  FontSize="10"
                                  TextColor="{StaticResource PrimaryColor}"/>
                            <Span Text="&#x20B9; "
                                  Style="{StaticResource Span16BoldPrimaryStyle}"
                                  TextColor="{StaticResource PrimaryColor}"
                                  FontSize="10"/>
                            <Span Text="{Binding Amount,Source={x:Reference navigationBarControl}}"
                                  Style="{StaticResource Span16BoldPrimaryStyle}"
                                  TextColor="{StaticResource PrimaryColor}"
                                  FontSize="10"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Border>

            <ImageButton
                Aspect="AspectFit"
                IsVisible="{Binding EndIconSource, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}, Source={x:Reference navigationBarControl}}"
                Source="{Binding EndIconSource, Source={x:Reference navigationBarControl}}"
                Command="{Binding MenuCommand, Source={x:Reference navigationBarControl}}"/>

        </HorizontalStackLayout>



    </Grid>

</ContentView>
