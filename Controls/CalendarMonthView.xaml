<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirIQ.Controls.CalendarMonthView">

    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="10"
          Padding="20,16,20,0"
          HorizontalOptions="Fill">

        <Label x:Name="monthLabel"
               Grid.Row="0"
               Style="{StaticResource Label18Bold}"
               TextColor="{StaticResource Onyx}"/>

        <!-- 6x7 grid of pooled cells, built once in code-behind and reused as the CollectionView
             recycles this view across months (see CalendarMonthView.xaml.cs). Every month is padded
             to exactly 6 rows so every instance of this view measures to the same height, which lets
             the outer CollectionView safely use ItemSizingStrategy="MeasureFirstItem" instead of
             measuring every month up front. -->
        <Grid x:Name="CalendarGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*,*,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="4"
              ColumnSpacing="2"/>
    </Grid>
</ContentView>
