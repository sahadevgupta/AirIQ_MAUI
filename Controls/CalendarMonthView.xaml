<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="AirIQ.Controls.CalendarMonthView">

    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="10"
          Padding="20,16,20,0"
          HorizontalOptions="Fill">

        <Label x:Name="monthLabel"
               Grid.Row="0"
               Style="{StaticResource Label18Bold}"
               TextColor="{StaticResource Onyx}"/>

        <!-- The whole 6x7 day grid is drawn as a single SkiaSharp canvas instead of composing a MAUI
             Border/Label per cell (see CalendarMonthView.xaml.cs for why: Android recreates a page's
             native view handlers every time it (re)appears, even when the C# view objects are pooled
             or the page itself is cached, so ~168 native views per visible month was the real,
             recurring cost - not anything the C#/data-layer optimizations could reach). -->
        <skia:SKCanvasView x:Name="canvasView"
                            Grid.Row="1"
                            HeightRequest="300"
                            HorizontalOptions="Fill"
                            PaintSurface="OnPaintSurface">
            <skia:SKCanvasView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCanvasTapped"/>
            </skia:SKCanvasView.GestureRecognizers>
        </skia:SKCanvasView>
    </Grid>
</ContentView>
